{
  "name": "voice-sentinel-ai",
  "version": "2.0.0",
  "description": "AI-Powered Real-Time Detection and Prevention of Voice Cloning Impersonation Attacks",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:fastapi": "uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "ml:dataset": "python ml_engine/generate_sample_dataset.py",
    "ml:train": "python ml_engine/train.py",
    "ml:eval": "python ml_engine/evaluate.py",
    "test:python": "pytest tests/",
    "blockchain:compile": "node blockchain/compile_contract.js"
  },
  "keywords": [
    "voice-cloning",
    "deepfake-detection",
    "pytorch",
    "fastapi",
    "cybersecurity",
    "audio-forensics",
    "blockchain-audit"
  ],
  "author": "Antigravity AI & AICTE Cyber Security Cell",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "ethers": "^6.11.1",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.16.0"
  }
}
